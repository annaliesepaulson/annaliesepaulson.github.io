pred_group,
pred_exams,
pred_any,
have_syllabus_preds),
by = join_by(school, sub_pref, course, section, semester, cur_year),
df_course
)
merged$tccns_id <- str_c(merged$tccns_sub_pref, merged$tccns_course)
#Create TCCNS counts overall and by school
merged <- merged %>%
group_by(tccns_id) %>%
mutate(n_tccns_id = n(),
n_school_tccns_id = n_distinct(school))
#these are a small number of Texas A&M and Texas A&M San Antonio courses that were relabeled
#between prediction and most recent data pull
stopifnot(sum(!is.na(merged$instnm)) == 943011)
#Remove bad merges and one course missing cip_six because it has no approval in admin
merged <- merged %>% filter(!is.na(instnm) & !is.na(cip_six))
#Keep only courses with five or more enrollments
cat("Dropping courses with fewer than five enrollments", sum(is.na(merged$enrollments))/nrow(merged))
merged <- merged %>% filter(!is.na(enrollments))
#Remove Central Texas because it's only a upper level institution
merged <- merged %>% filter(instnm != "Texas A&M University-Central Texas")
#Set fixed effects relative to UT-Austin
merged$instnm <- as.factor(merged$instnm)
merged$instnm <- relevel(merged$instnm,
ref = "The University of Texas at Austin")
merged$sub_num_school = paste0(merged$sub_pref, merged$course, merged$school)
merged <- merged %>%
group_by(sub_num_school) %>%
mutate(n_sub_num_school = n()) %>%
ungroup()
merged <- merged %>%
group_by(sub_num_school, term) %>%
mutate(n_sub_num_school_term = n()) %>%
ungroup()
merged %>%
group_by(have_syllabus_preds) %>%
summarize(n_enrollments = sum(enrollments, na.rm = T),
n_course = n())
merged %>%
summarise(
across(
c(pred_exams, pred_writing, pred_communication, pred_group),
list(
mean = ~mean(.x, na.rm = TRUE),
sd   = ~sd(.x, na.rm = TRUE)
)
)
)
merged %>%
select(pred_exams,
pred_writing,
pred_group,
pred_communication) %>%
cor()
merged <- merged %>%
group_by(sub_num_school) %>%
mutate(prop_writing = mean(pred_writing),
prop_group = mean(pred_group),
prop_communication = mean(pred_communication),
prop_exams = mean(pred_exams))
mod_exam <- feols(pred_exams ~ 1 | cip_six,
data = merged)
mod_exam
r2(merged)
r2(mod_exam)
